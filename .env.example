# Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_id
BOT_USERNAME=WhisperBot

# Database Configuration
# Option 1: Direct URL
DATABASE_URL=postgresql://user:password@localhost:5432/whisperbot

# Option 2: Individual components (uncomment and configure if needed)
# POSTGRES_SERVER=localhost
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=whisperbot
# DATABASE_URL=  # Will be automatically constructed from above

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
DEBUG=False
ENVIRONMENT=development

# Limits
MAX_MESSAGE_LENGTH=1000
MIN_USERNAME_LENGTH=3
MAX_USERNAME_LENGTH=20
SESSION_TIMEOUT_HOURS=1

# Rate Limiting
RATE_LIMIT_MESSAGES_PER_HOUR=10
ENABLE_FLOOD_PROTECTION=true

# Analytics
ENABLE_ANALYTICS=true
CLEANUP_OLD_SESSIONS_HOURS=24
